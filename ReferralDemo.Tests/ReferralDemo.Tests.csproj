<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- This is what pulls in ReferralDemo's code AND transitively restores
         its dependencies (MediatR, OpenTelemetry, etc.) when you restore
         or build THIS project. You don't need to restore the main project
         separately. -->
    <ProjectReference Include="..\ReferralDemo\ReferralDemo.csproj" />
  </ItemGroup>

</Project>
